{
  "name": "nexus-breach-2d",
  "version": "1.0.0",
  "description": "Real-time multiplayer treasure hunt: top-down 2D edition",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "bots": "node scripts/bots.js",
    "sprites": "node scripts/bake-sprites.mjs",
    "event": "sh -c 'until node server/index.js; do echo \"[event] server stopped unexpectedly, restarting in 1s\"; sleep 1; done'"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.3",
    "qrcode-generator": "^1.4.4",
    "socket.io": "^4.8.4",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "socket.io-client": "^4.8.4"
  }
}
